{
  "$schema": "https://opencode.ai/config.json",
  "username": "Mykhailo",
  "shell": "/bin/zsh",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": "notify",
  "formatter": true,
  "instructions": [
    "AGENTS.md"
  ],
  "enabled_providers": [
    "opencode",
    "openai",
    "neuralwatt"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    },
    "neuralwatt": {
      "options": {
        "apiKey": "{env:NEURALWATT_API_KEY}",
      },
    }
  },
  "agent": {
    "build": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "high",
      "permission": {
        "question": "allow",
        "plan_enter": "allow"
      }
    },
    "plan": {
      "model": "{env:OPENCODE_BIG_MODEL}",
      "variant": "high",
      "permission": {
        "question": "allow",
        "plan_exit": "allow",
        "task": {
          "general": "deny"
        },
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          ".local/share/opencode/plans/*.md": "allow",
        },
        "webfetch": "allow",
        "websearch": "allow",
      }
    },
    "general": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "medium",
      "permission": {
        "todowrite": "deny"
      }
    },
    "explore": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "variant": "medium",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": {
          "*": "ask"
        }
      }
    },
    "compaction": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "high",
      "permission": {
        "*": "deny"
      }
    },
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "variant": "medium",
      "permission": {
        "*": "deny"
      }
    },
    "summary": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "variant": "medium",
      "permission": {
        "*": "deny"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "edit": "ask",
    "lsp": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "tree *": "allow",
      "ls *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "which *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "env": "allow",
      "env *": "allow",
      "uname *": "allow",
      "date": "allow",
      "date *": "allow",
      "xargs *": "allow",
      "jq *": "allow",
      "npm run *": "allow",
      "swift *": "allow",
      "test *": "allow",
      "agent-browser *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git merge *": "deny",
      "git tag *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "su": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "source *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
