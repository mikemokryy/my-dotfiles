{
  "$schema": "https://opencode.ai/config.json",
  "username": "Mykhailo",
  "shell": "/bin/zsh",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": "notify",
  "formatter": true,
  "instructions": [
    "AGENTS.md"
  ],
  "enabled_providers": [
    "openai",
    "neuralwatt"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          }
        }
      }
    },
    "neuralwatt": {
      "options": {
        "apiKey": "{env:NEURALWATT_API_KEY}",
      },
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "textVerbosity": "low",
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              },
              "reasoningEffort": "none"
            },
          },
        },
        "glm-5.2": {
          "options": {
            "textVerbosity": "low",
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              },
              "reasoningEffort": "none"
            },
          }
        },
        "glm-5.2-short": {
          "options": {
            "textVerbosity": "low",
          }
        },
        "glm-5.2-short-fast": {
          "options": {
            "textVerbosity": "low",
          },
        },
      },
    }
  },
  "agent": {
    "build": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "max",
    },
    "plan": {
      "model": "{env:OPENCODE_BIG_MODEL}",
      "variant": "high",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "general": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "medium",
    },
    "explore": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "variant": "medium",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": {
          "*": "ask",
          "~/Developer/**": "allow"
        }
      }
    },
    "compaction": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "medium",
    },
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "variant": "none",
    },
    "summary": {
      "model": "{env:OPENCODE_MODEL}",
      "variant": "low",
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "edit": "ask",
    "lsp": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": {
      "*": "ask",
      "~/Developer/**": "allow"
    },
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "python*": "ask",
      "node*": "ask",
      "npx*": "ask",
      "git commit *": "deny",
      "git push *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git merge *": "deny",
      "git tag *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "su": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "source *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
