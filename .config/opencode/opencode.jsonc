{
  "$schema": "https://opencode.ai/config.json",
  "username": "Mykhailo",
  "shell": "/bin/zsh",
  "model": "neuralwatt/glm-5.2",
  // "small_model": "neuralwatt/glm-5.2",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": "notify",
  "instructions": [
    "AGENTS.md"
  ],
  "enabled_providers": [
    "opencode",
    "openai",
    "neuralwatt"
  ],
  "agent": {
    "build": {
      "description": "Primary build agent for writing, refactoring, and executing tasks. High reasoning effort.",
      "mode": "primary",
      "model": "neuralwatt/glm-5.2",
      "variant": "high"
    },
    "plan": {
      "description": "Read-only planning agent. Extra-high reasoning effort. Cannot edit files; inherits global bash policy.",
      "mode": "primary",
      "model": "neuralwatt/glm-5.2",
      "variant": "xhigh",
      "permission": {
        "edit": "deny"
      }
    },
    "general": {
      "description": "General-purpose chat agent with no project context.",
      "mode": "subagent",
      "model": "neuralwatt/glm-5.2",
      "variant": "medium"
    },
    "explore": {
      "description": "Fast read-only codebase exploration agent.",
      "mode": "subagent",
      "model": "neuralwatt/glm-5.2",
      "variant": "high",
      "permission": {
        "edit": "deny"
      }
    },
    "title": {
      "model": "neuralwatt/glm-5.2",
      "variant": "minimal"
    },
    "summary": {
      "model": "neuralwatt/glm-5.2",
      "variant": "low"
    },
    "compaction": {
      "model": "neuralwatt/glm-5.2",
      "variant": "low"
    }
  },
  "permission": {
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "tree *": "allow",
      "ls *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "which *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "env": "allow",
      "env *": "allow",
      "uname *": "allow",
      "date": "allow",
      "date *": "allow",
      "xargs *": "allow",
      "jq *": "allow",
      "npm run *": "allow",
      "swift *": "allow",
      "test *": "allow",
      "agent-browser *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git merge *": "deny",
      "git tag *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "su": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "source *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
