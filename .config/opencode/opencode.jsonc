{
  "$schema": "https://opencode.ai/config.json",
  "username": "Mykhailo",
  "shell": "/bin/zsh",
  "model": "{env:OPENCODE_MODEL}",
  "default_agent": "build",
  "share": "disabled",
  "update": "notify",
  "formatter": true,
  "instructions": [
    "AGENTS.md"
  ],
  "experimental": {
    "todo": true
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "neuralwatt",
      "effect": "allow"
    }
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Developer/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "node*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npx*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git merge *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git tag *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ssh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "scp *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "eval *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "exec *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "source *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mkfs *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "reboot *",
      "effect": "deny"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "settings": {
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-luna": {
          "settings": {
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-sol": {
          "settings": {
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    },
    "neuralwatt": {
      "settings": {
        "apiKey": "{env:NEURALWATT_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "settings": {
            "textVerbosity": "low"
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "thinking": {
                  "type": "disabled"
                },
                "reasoningEffort": "none"
              }
            }
          ]
        },
        "deepseek-v4.1-flash": {
          "settings": {
            "textVerbosity": "low"
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "thinking": {
                  "type": "disabled"
                },
                "reasoningEffort": "none"
              }
            },
            {
              "id": "gh-publisher",
              "body": {
                "temperature": 0.1
              }
            }
          ]
        },
        "glm-5.3": {
          "settings": {
            "textVerbosity": "low"
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "thinking": {
                  "type": "disabled"
                },
                "reasoningEffort": "none"
              }
            },
            {
              "id": "academic-writer",
              "settings": {
                "thinking": {
                  "type": "disabled"
                },
                "reasoningEffort": "none"
              },
              "body": {
                "temperature": 0.3
              }
            },
            {
              "id": "bug-triage",
              "settings": {
                "reasoningEffort": "max"
              },
              "body": {
                "temperature": 0.1
              }
            },
            {
              "id": "change-auditor",
              "settings": {
                "reasoningEffort": "high"
              },
              "body": {
                "temperature": 0.1
              }
            }
          ]
        },
        "glm-5.3-short": {
          "settings": {
            "textVerbosity": "low"
          }
        },
        "glm-5.3-short-fast": {
          "settings": {
            "textVerbosity": "low"
          }
        },
        "kimi-k3": {
          "variants": [
            {
              "id": "research",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "{env:OPENCODE_MODEL}#xhigh"
    },
    "plan": {
      "model": "{env:OPENCODE_BIG_MODEL}#high",
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "model": "{env:OPENCODE_MODEL}#high"
    },
    "explore": {
      "model": "{env:OPENCODE_SMALL_MODEL}#high",
      "permissions": [
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "external_directory",
          "resource": "~/Developer/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/tmp/*",
          "effect": "allow"
        }
      ]
    },
    "compaction": {
      "model": "{env:OPENCODE_MODEL}#high"
    },
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}#none"
    },
    "summary": {
      "model": "{env:OPENCODE_MODEL}#low"
    }
  }
}
