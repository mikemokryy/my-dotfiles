# Ghostty configuration
# Colors live in themes/terafox (upstream nightfox palette).

theme = terafox

# Font
font-family = "FiraCode Nerd Font Mono"
font-size = 15.5
font-thicken = true
adjust-cell-width = "-10%"
adjust-cell-height = "10%"

# Window
maximize = true
background-opacity = 0.9
background-blur-radius = 20
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend

# Cursor
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# Shell integration
# ssh-env/ssh-terminfo propagate integration and terminfo over SSH.
shell-integration = fish
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# macOS
macos-option-as-alt = left
desktop-notifications = true
bell-features = no-system

# Keep alt+arrows from deleting words (nvim)
keybind = alt+left=unbind
keybind = alt+right=unbind
