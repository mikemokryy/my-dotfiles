{
  "model": "claude-opus-4.6",
  "effortLevel": "high",
  "skillDirectories": [
    "~/.claude/skills",
    "~/.agents/skills"
  ],
  "disabledSkills": [],
  "showReasoning": false,
  "allowedUrls": [
    "https://github.com"
  ],
  "allowedTools": [
    "shell(cat:*)",
    "shell(head:*)",
    "shell(tail:*)",
    "shell(less:*)",
    "shell(wc:*)",
    "shell(file:*)",
    "shell(diff:*)",
    "shell(bat:*)",
    "shell(sort:*)",
    "shell(uniq:*)",
    "shell(awk:*)",
    "shell(sed:*)",
    "shell(cut:*)",
    "shell(tr:*)",
    "shell(grep:*)",
    "shell(rg:*)",
    "shell(find:*)",
    "shell(fd:*)",
    "shell(tree:*)",
    "shell(ls:*)",
    "shell(stat:*)",
    "shell(du:*)",
    "shell(pwd:*)",
    "shell(echo:*)",
    "shell(printf:*)",
    "shell(which:*)",
    "shell(dirname:*)",
    "shell(basename:*)",
    "shell(realpath:*)",
    "shell(env:*)",
    "shell(uname:*)",
    "shell(date:*)",
    "shell(xargs:*)",
    "shell(jq:*)",
    "shell(node:*)",
    "shell(python:*)",
    "shell(npm run:*)"
  ],
  "deniedTools": [
    "shell(git commit)",
    "shell(git push)",
    "shell(git rebase)",
    "shell(git reset)",
    "shell(git clean)",
    "shell(git merge)",
    "shell(git tag)",
    "shell(ssh:*)",
    "shell(scp:*)",
    "shell(sudo:*)",
    "shell(su)",
    "shell(eval)",
    "shell(exec)",
    "shell(source)",
    "shell(dd)",
    "shell(mkfs:*)",
    "shell(shutdown:*)",
    "shell(reboot)"
  ],
  "enabledMcpServers": [
    "github-mcp-server",
    "next-devtools-mcp",
    "@heroui/react-mcp"
  ],
  "colorMode": "default"
}
