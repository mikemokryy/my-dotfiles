{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "solarized dark",
  "enableTelemetry": false,
  "enableTerminalSandbox": true,
  "model": "Gemini 3.5 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(less)",
      "command(wc)",
      "command(file)",
      "command(diff)",
      "command(bat)",
      "command(sort)",
      "command(uniq)",
      "command(awk)",
      "command(sed)",
      "command(cut)",
      "command(tr)",
      "command(grep)",
      "command(rg)",
      "command(find)",
      "command(fd)",
      "command(tree)",
      "command(ls)",
      "command(stat)",
      "command(du)",
      "command(pwd)",
      "command(echo)",
      "command(printf)",
      "command(which)",
      "command(dirname)",
      "command(basename)",
      "command(realpath)",
      "command(env)",
      "command(uname)",
      "command(date)",
      "command(xargs)",
      "command(jq)",
      "command(swift test)"
    ],
    "deny": [
      "command(git commit)",
      "command(git push)",
      "command(git rebase)",
      "command(git reset)",
      "command(git clean)",
      "command(git merge)",
      "command(git tag)",
      "command(ssh)",
      "command(scp)",
      "command(sudo)",
      "command(su)",
      "command(eval)",
      "command(exec)",
      "command(source)",
      "command(dd)",
      "command(mkfs)",
      "command(shutdown)",
      "command(reboot)"
    ],
    "ask": [
      "command(node)",
      "command(python)",
      "command(python3)",
      "command(npx)"
    ]
  },
  "showFeedbackSurvey": false,
  "showTips": false,
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "subagent_model": "gemini-3.5-flash-high",
  "toolPermission": "strict",
  "trustedWorkspaces": [],
  "verbosity": "low"
}
